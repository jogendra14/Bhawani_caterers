# ==========================================
# Bhawani Caterers - Root .gitignore
# ==========================================

# 1. Environment & Secret Credentials (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env

# 2. Dependency Directories (Heavy - install via npm install)
node_modules/
backend/node_modules/
frontend/node_modules/
jspm_packages/
.pnp
.pnp.js

# 3. Production Builds & Compiled Outputs
dist/
dist-ssr/
build/
frontend/dist/
frontend/build/
*.tsbuildinfo

# 4. Logs & Debugging Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS Generated & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 6. IDEs and Editors
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 7. Testing & Coverage
coverage/
.nyc_output/
*.lcov

# 8. Temporary & Cache Files
.cache/
.parcel-cache/
.eslintcache
