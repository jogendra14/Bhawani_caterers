# MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0

# Admin Secret Key
ADMIN_SECRET_KEY=your-super-secret-admin-key-123

# Initial SuperAdmin Setup
SUPERADMIN_NAME=SuperAdmin
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PHONE=9876543210
SUPERADMIN_PASSWORD=your_secure_password

# JWT Auth Tokens
JWT_ACCESS_SECRET=your_jwt_access_secret_key
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_ACCESS_EXPIRE=3d
JWT_REFRESH_EXPIRE=7d

# Server Config
PORT=5000
NODE_ENV=production

# Frontend Client URL (For CORS)
FRONTEND_URL=https://your-frontend-domain.vercel.app
CLIENT_URL=https://your-frontend-domain.vercel.app

# SMTP Email Config (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL=noreply@bhawanicaterers.com
FROM_NAME=Bhawani Caterers
